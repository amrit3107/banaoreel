<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows plain HTTP (cleartext) traffic to local dev addresses only.
  Production builds should point BASE_URL at an https:// backend instead
  of relying on this — this file exists purely so local testing works.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- Add your machine's LAN IP here too if testing on a physical device, e.g.: -->
        <!-- <domain includeSubdomains="false">192.168.1.42</domain> -->
    </domain-config>
</network-security-config>
