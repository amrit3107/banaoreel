# Backend internal API
BACKEND_BASE_URL=http://localhost:8080
INTERNAL_API_KEY=change-this-shared-secret

# Queue
SQS_QUEUE_URL=

# AI providers
ANTHROPIC_API_KEY=
IMAGE_GEN_API_KEY=
ELEVENLABS_API_KEY=

# Storage
S3_BUCKET=banaoreel-videos
AWS_REGION=ap-south-1

# Local render workspace
TMP_DIR=/tmp/banaoreel-render

# Optional: path to a royalty-free background music file mixed under narration.
# If unset, videos render with narration only, no music bed.
MUSIC_BED_PATH=
